# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Origin for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Recipient Email (Where messages from the contact form will be delivered)
RECIPIENT_EMAIL=aquidali.dhandu.placeholder@example.com

# ----------------------------------------------------------------------
# Email Delivery Provider Configuration
# Set either Resend OR standard SMTP credentials below.
# ----------------------------------------------------------------------

# Provider Selection: "resend" | "smtp" | "none"
EMAIL_PROVIDER=resend

# Option 1: Resend (Recommended for production: https://resend.com)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Option 2: Standard SMTP (Gmail, Brevo, AWS SES, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Aquid Portfolio" <your_smtp_username@gmail.com>
